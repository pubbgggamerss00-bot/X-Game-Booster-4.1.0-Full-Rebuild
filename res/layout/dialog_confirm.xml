<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/paddingNormal" android:layout_marginEnd="@dimen/paddingNormal">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_dialog_confirm" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/paddingSmall2" android:paddingStart="@dimen/paddingLarge" android:paddingEnd="@dimen/paddingLarge">
            <ImageView android:id="@id/img_dialog_confirm_logo" android:layout_width="@dimen/icDialogIconSize" android:layout_height="@dimen/icDialogIconSize" android:layout_marginTop="@dimen/paddingLargeX" android:contentDescription="logo" app:srcCompat="@drawable/ic_premium" />
            <TextView android:textSize="@dimen/textsizeSmall" android:textColor="@color/colorWhiteMain" android:gravity="center" android:id="@id/txt_dialog_confirm_title" android:paddingTop="@dimen/paddingSmall" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="TextView" android:fontFamily="@font/main_bold" />
            <TextView android:textSize="@dimen/textsizeSmall" android:textColor="@color/colorWhite" android:gravity="center" android:id="@id/txt_dialog_confirm_body" android:paddingBottom="@dimen/paddingLargeX" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="TextView" android:alpha="0.8" android:fontFamily="@font/main_normal" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/textsizeSmall" android:textColor="@color/colorWhiteMain" android:gravity="center" android:id="@id/txt_dialog_confirm_button1" android:background="@drawable/bg_button_dialog_default" android:paddingTop="@dimen/paddingSmall" android:paddingBottom="@dimen/paddingSmall" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/paddingSmall2" android:text="TextView" android:fontFamily="@font/main_bold" android:paddingStart="@dimen/paddingNormal" android:paddingEnd="@dimen/paddingNormal" />
            <TextView android:textSize="@dimen/textsizeSmall" android:textColor="@color/colorWhiteMain" android:gravity="center" android:id="@id/txt_dialog_confirm_button2" android:background="@drawable/bg_button_dialog_red" android:paddingTop="@dimen/paddingSmall" android:paddingBottom="@dimen/paddingSmall" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/paddingSmall2" android:text="TextView" android:fontFamily="@font/main_bold" android:paddingStart="@dimen/paddingNormal" android:paddingEnd="@dimen/paddingNormal" />
            <TextView android:textSize="@dimen/textsizeSmall" android:textColor="@color/colorWhiteMain" android:gravity="center" android:id="@id/txt_dialog_confirm_button3" android:background="@drawable/bg_button_dialog_red" android:paddingTop="@dimen/paddingSmall" android:paddingBottom="@dimen/paddingSmall" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="TextView" android:fontFamily="@font/main_bold" android:paddingStart="@dimen/paddingNormal" android:paddingEnd="@dimen/paddingNormal" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>