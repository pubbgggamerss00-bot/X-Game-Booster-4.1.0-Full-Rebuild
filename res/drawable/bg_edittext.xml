<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item app:state_invalid="true">
        <shape>
            <corners android:radius="10.0dip" />
            <solid android:color="#ff515151" />
            <stroke android:width="3.0dip" android:color="#ffffa1a1" />
        </shape>
    </item>
    <item app:state_valid="true">
        <shape>
            <corners android:radius="10.0dip" />
            <solid android:color="#ff515151" />
            <stroke android:width="3.0dip" android:color="#ff9dd5ff" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10.0dip" />
            <solid android:color="#ff515151" />
            <stroke android:width="3.0dip" android:color="#fffff069" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10.0dip" />
            <solid android:color="#ff515151" />
        </shape>
    </item>
</selector>